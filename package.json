{
	"name": "@chrisstone/ts-jsonapi",
	"version": "1.1.1",
	"description": "TypeScript type definitions for JSON:API v1.1",
	"homepage": "https://github.com/chrisstone/ts-jsonapi#readme",
	"bugs": {
		"url": "https://github.com/chrisstone/ts-jsonapi/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/chrisstone/ts-jsonapi.git"
	},
	"license": "MIT",
	"author": "Chris Stone",
	"keywords": [
		"jsonapi",
		"json:api",
		"typescript",
		"types",
		"rest",
		"api"
	],
	"files": [
		"dist/**/*.js",
		"dist/**/*.js.map",
		"dist/**/*.d.ts",
		"dist/**/*.d.ts.map",
		"dist/esm/package.json",
		"README.md",
		"LICENSE"
	],
	"main": "dist/index.js",
	"module": "dist/esm/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/esm/index.d.ts",
				"default": "./dist/esm/index.js"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc && tsc -p tsconfig.esm.json && node -e \"require('fs').writeFileSync('dist/esm/package.json', '{\\\"type\\\":\\\"module\\\"}\\\\n')\"",
		"test": "tsc -p tsconfig.spec.json && npx jasmine --config=spec/support/jasmine.json",
		"prepare": "npm run build"
	},
	"engines": {
		"node": ">=22"
	},
	"devDependencies": {
		"@types/jasmine": "^6.0.0",
		"jasmine": "^6.2.0",
		"typescript": "^5.0.0"
	}
}
